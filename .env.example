# ANTELLAY SPACE OPERATIONS - ENVIRONMENT TEMPLATE (.env.example)

PORT=3000

# 1. NASA DONKI API Key (Get free key from api.nasa.gov)
NASA_API_KEY=DEMO_KEY

# 2. Space-Track Account Credentials
SPACETRACK_USER=your_email@domain.com
SPACETRACK_PASS=your_password

# 3. USGS EarthExplorer Token
USGS_API_KEY=your_usgs_m2m_token

# 4. Endpoints
CELESTRAK_ENDPOINT=https://celestrak.org/NORAD/elements/gp.php
NOAA_ENDPOINT=https://services.swpc.noaa.gov/json

# 5. Terrestrial & Launch Weather API Key
WEATHER_API_KEY=your_weather_api_key_here

